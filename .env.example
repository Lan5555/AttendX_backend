# Server
PORT=3000
NODE_ENV=development

# Auth
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=7d

# Database (SQLite file — zero external setup needed for the MVP/demo)
DB_PATH=attendx.sqlite

# Attendance verification
QR_ROTATION_SECONDS=8
QR_VALID_WINDOWS=2
BLE_PROXIMITY_RSSI_THRESHOLD=-70

# Default attendance threshold used for newly created courses
DEFAULT_ATTENDANCE_THRESHOLD=75
